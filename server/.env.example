# MeshLLM 服务端本地配置示例
#
# 用法:复制为 server/.env(已在 .gitignore 中,不会进仓库),按需取消注释。
# 已存在的系统/命令行环境变量优先级更高 —— 临时覆盖:
#   MESH_TURN_URLS=... npm start
# 关闭整个文件:MESH_ENV_DISABLE=1

# ---- 基础 ----
# MESH_PORT=4011
# MESH_HOST=0.0.0.0
# MESH_DATA_FILE=./data.json

# ---- ICE / TURN(跨网段调用)----
# 留空 = 不启用 TURN,跨网段调用自动退化为 /dc 中转(能用,但所有流量都过服务器)。
# 启用本地 TURN 后,跨网段恢复"直连优先,失败再中转"。
# 启动本地 TURN:turn/start-turn.bat(Windows)或 node turn/server.mjs
# 地址里的 IP 必须是对端(另一个网段的浏览器)能访问到的地址;
# 108 在内网时填内网 IP 只对同网段有效,跨网段需要公网 IP + 路由器端口映射。
# MESH_TURN_URLS=turn:192.168.2.108:3478?transport=udp,turn:192.168.2.108:3478?transport=tcp
# MESH_TURN_USERNAME=meshllm
# MESH_TURN_CREDENTIAL=meshllm-devnet

# 只用公共 STUN(默认已是 Google STUN,一般不用改)
# MESH_STUN_URLS=stun:stun.l.google.com:19302

# ---- 联邦(Bootstrap 互联)----
# 对端 bootstrap 地址,逗号分隔。回环防护依赖 MESH_SELF_URL 正确指向自己。
# MESH_PEER_BOOTSTRAPS=https://192.168.2.174:4011
# MESH_SELF_URL=https://192.168.2.108:4011

# ---- 结算 ----
# sim(模拟账本) | devnet(真实链上)
# MESH_SETTLE_MODE=sim
# MESH_RPC_URL=https://api.devnet.solana.com

# ---- 联调额度 ----
# 新钱包赠送的测试额度(raw,6 位小数;100000000 = 100 USDT)
# MESH_TEST_CREDIT_RAW=100000000
